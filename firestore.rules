rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'oQzua4tAERYx5xxcopWh4pWo8SI2';
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['fullName', 'age', 'language', 'createdAt', 'updatedAt'])
        && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 80
        && d.age is int && d.age >= 5 && d.age <= 120
        && d.language in ['az', 'en'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if request.auth != null && request.auth.uid == userId && validProfile();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
